# Направление зависимостей (import-linter). Запуск: lint-imports из корня.
#
# Стратегия канона: enforce то, что уже соблюдается; расширять по мере слоёв.
# Легаси-нарушения — в ignore_imports с пометкой вида "TODO: PROJ-123".
# Здесь ignore_imports пуст: проект новый, нарушать ещё нечего.

[importlinter]
root_packages =
    ahrefs_cases

# --------------------------------------------------------------------
# Контракт 1: ядро не знает про обвязку.
# Главный архитектурный инвариант проекта (delivery/CONSTITUTION.md):
# сбор, классификация и сборка кейса — библиотека с данными на входе и
# выходе. Именно на этом держится тестируемость ядра без сервера и сети.
# У инварианта два исполнителя: этот контракт (импорты пакетов) и
# tests/test_core_isolation.py (импорты внешних библиотек).
# --------------------------------------------------------------------
[importlinter:contract:core-does-not-know-web]
name = ядро не импортирует api и workers
type = forbidden
source_modules =
    ahrefs_cases.intake
    ahrefs_cases.collect
    ahrefs_cases.classify
    ahrefs_cases.cases
    ahrefs_cases.export
    ahrefs_cases.storage
    ahrefs_cases.config
forbidden_modules =
    ahrefs_cases.api
    ahrefs_cases.workers

# --------------------------------------------------------------------
# Контракт 2: порядок слоёв. Верхние знают про нижние, не наоборот.
# Порядок повторяет пайплайн: приём → сбор → классификация → кейс.
# Классификация не должна тянуть сбор: она обязана быть бесплатной и
# переигрываемой на уже собранных данных (docs/IMPLEMENTATION_V3.md §3).
# --------------------------------------------------------------------
[importlinter:contract:layers]
name = слои: обвязка → кейсы → классификация → сбор → хранилище → конфиг
type = layers
layers =
    ahrefs_cases.api : ahrefs_cases.workers
    ahrefs_cases.cases : ahrefs_cases.export
    ahrefs_cases.classify
    ahrefs_cases.collect : ahrefs_cases.intake
    ahrefs_cases.storage
    ahrefs_cases.config
