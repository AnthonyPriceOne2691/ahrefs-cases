# Ahrefs cases — пример конфига. Только имена переменных, без значений.
# Реальные значения держим вне репозитория (.env локально / secrets в CI).

# --- Ahrefs API v3 ---
# fixture — записанные и синтетические ответы (дефолт: разработка без ключа и без сети)
# live — настоящие запросы, нужен AHREFS_API_KEY
AHREFS_PROVIDER=fixture
AHREFS_API_KEY=
AHREFS_BASE_URL=https://api.ahrefs.com
AHREFS_TIMEOUT_SEC=60
AHREFS_RETRY_COUNT=3
AHREFS_RETRY_BACKOFF_SEC=1,5,30
# Мягкий стоп по квоте: не начинать новый прогон, если остаток units ниже порога
AHREFS_UNITS_MIN_LEFT=5000

# --- Хранилище ---
DATABASE_URL=postgresql+asyncpg://cases:cases@postgres:5432/cases

# --- Кэш, очередь, single-flight ---
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=cases
WORKER_CONCURRENCY=1          # прогонов одновременно; >2 ломает смету units
COLLECT_MAX_PARALLEL=3        # запросов к Ahrefs внутри одного прогона

# --- Аутентификация ---
JWT_SECRET=
JWT_TTL_HOURS=12

# --- Сбор: экономия units (см. docs/UNITS_ECONOMY.md) ---
AHREFS_HISTORY_GROUPING=monthly     # daily раздувает строки ~30x, билл идёт за строки
AHREFS_MAX_HISTORY_MONTHS=24        # потолок глубины периода
AHREFS_COLLECT_DR_HISTORY=false     # DR-история платная, текущий DR бесплатен (Q20)
AHREFS_STAGE2_ONLY_FOR_CASES=true   # дорогие метрики — только для good/medium

# --- Классификация ---
# Сид дефолтов для первого запуска. Рабочие пороги — в БД, правятся из UI (Ф4)
THRESHOLDS_SEED_PATH=./config/thresholds.example.yml

# --- Экспорт ---
EXPORT_OUTPUT_DIR=./data/out
EXPORT_FORMAT=html

# --- ИИ (опционально, Ф2+; см. docs/AI_USAGE.md) ---
# Без ключа сервис работает полностью: текст кейса шаблонный, ниша не автозаполняется
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=
LLM_PROMPTS_DIR=./prompts

# --- fixture-режим ---
# Где лежит таблица «домен → сценарий» и зерно генератора синтетики.
# Смена зерна переписывает все синтетические серии — на них стоят golden-тесты Ф3.
AHREFS_FIXTURES_DIR=data/fixtures
AHREFS_FIXTURE_SEED=42
# Запас истории до старта работ (точка А и baseline Ф3).
AHREFS_HISTORY_LEAD_MONTHS=3
# Сколько часов текущий (незакрытый) месяц считается свежим и не перезапрашивается.
AHREFS_CURRENT_MONTH_TTL_HOURS=24
# Предварительный порог отбора кандидатов шага 2 (рост трафика). Не классификация.
AHREFS_STAGE2_MIN_GROWTH=1.1
# --- устойчивость прогона ---
# Сколько неудач ПОДРЯД означают «Ahrefs лёг»: прогон останавливается,
# остаток задач помечается skipped_aborted и не тратит units на таймауты.
COLLECT_BREAKER_MAX_FAILURES=5
# Через сколько задач фиксировать собранное: прерванный прогон теряет не больше.
COLLECT_CHECKPOINT_EVERY=10
# Через сколько секунд прогон в running считается мёртвым (реапер).
COLLECT_RUN_STALE_SEC=16200
# Как долго помнить, что у домена нет истории, и не покупать ту же пустоту.
AHREFS_EMPTY_RETRY_DAYS=30
# Порог для прогонов, которые так и не начались (очередь их не подхватила).
COLLECT_RUN_QUEUED_STALE_SEC=7200

# Пороги заказчика (Приложение А) лежат вне репозитория по варианту D.
# По умолчанию сервис берёт нейтральные умолчания config/thresholds.default.yml.
THRESHOLDS_SEED_PATH=./config/thresholds.example.yml
# Жёсткий лимит длительности прогона. Порог реапера обязан быть строго больше:
# иначе реапер добьёт работающий прогон и освободит его резерв units.
COLLECT_RUN_TIMEOUT_SEC=14400
